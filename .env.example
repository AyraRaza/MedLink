# Copy this file to .env and fill in real values. Never commit .env.

APP_NAME=MedLink API
APP_ENV=development
DEBUG=true

# Dev default (SQLite). In production this MUST be a postgresql:// URL.
DATABASE_URL=sqlite:///./medlink.db
# DATABASE_URL=postgresql://medlink_user:password@localhost:5432/medlink

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-this-with-a-long-random-value

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:3000
